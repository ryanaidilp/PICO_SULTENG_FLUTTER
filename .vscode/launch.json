    {
      "name": "Pico - Production",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/apps/pico/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/pico",
      "args": [
        "--flavor",
