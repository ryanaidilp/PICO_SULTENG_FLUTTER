{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico - Development",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/apps/pico/lib/main_development.dart",
      "cwd": "${workspaceFolder}/apps/pico",
      "args": [
        "--flavor",
        "development"
      ],
      "preLaunchTask": "prepare-development"
    },
    {
      "name": "Pico - Development (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/apps/pico/lib/main_development.dart",
      "cwd": "${workspaceFolder}/apps/pico",
      "args": [
        "--flavor",
        "development"
      ],
      "flutterMode": "profile",
      "preLaunchTask": "prepare-development"
    },
    {
      "name": "Pico - Staging",
